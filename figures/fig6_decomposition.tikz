  legend style={at={(1.03,0.5)}, anchor=west}, legend reversed]
  \addplot[fill=okGrey!35, draw=none] table[x=day, y=R0, col sep=comma] {\datapath/e4_state_S3_coupled.csv} \closedcycle;
